{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-futbol-edge",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomCoordinator"
      },
      {
        "name": "CHAT",
        "class_name": "ChatHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomCoordinator"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ChatHub"
      ]
    }
  ]
}
